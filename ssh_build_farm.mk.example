# Copy this file to ssh_build_farm.mk (gitignored) and fill in your builder hostnames.
# ssh_build_farm.mk is never committed — hostnames and addresses stay out of git.
# FARM_REPO must be an absolute path or a tilde path the remote shell can expand.

FEDORA_BUILDER    := fedora_builder
UBUNTU_BUILDER    := ubuntu_builder
MAC_BUILDER       := mac_builder
FEDORA_FARM_REPO  := ~/EQ36-dist
UBUNTU_FARM_REPO  := ~/EQ36-dist
MAC_FARM_REPO     := ~/EQ36-dist

# Remote URLs default to HTTPS in the Makefile so farm builds work on machines
# without SSH keys.  Uncomment to override with SSH on builders that have keys:
# REPO_URL         = git@github.com:jonnyprouty/EQ3_6-dist.git
# UPSTREAM_URL     = git@github.com:llnl/EQ3_6.git
# UPSTREAM_DEW_URL = git@gitlab.com:ENKI-portal/SUPCRTandEQs.git
