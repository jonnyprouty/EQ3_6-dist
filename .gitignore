# Build artifacts
/obj/
/bin/
/obj-dew/
/bin-dew/

# Generated packaging files (produced from *.in templates by make)
/pkg/rpm/eq3_6.spec
/pkg/rpm/eq3_6_dew.spec
/pkg/brew/eq3_6.rb
/pkg/brew/eq3_6_dew.rb
/pkg/brew/SUPCRTandEQs_DEW_activities.tar.gz

# Extracted Fortran source (regenerated by make extract)
/src/

# Downloaded documentation (fetched by make docs)
/docs/*.pdf

# Packaging build trees and output
/pkg/rpm/build/
/pkg/deb/staging/
/pkg/dist/

# Generated deb binary control files (produced from *.in templates by make generate)
/pkg/deb/debian/control.eq3-6
/pkg/deb/debian/control.eq3-6-doc
/pkg/deb/debian/control.dew

# Debian build artifacts (land one level above pkg/deb/ with dpkg-buildpackage)
*.deb
*.changes
*.buildinfo
*.dsc

# Test cache and run artifacts
/tests/.data1_cache

# EQ3/6 runtime output files (produced when running executables from repo root)
/data1
/data1f
/output
/slist

# DEW community test case archives (large ZIP files, fetched separately)
/DEW/

# macOS
.DS_Store

# Vim swap files
*.swp
*.swo
