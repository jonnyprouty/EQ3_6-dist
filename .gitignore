# Build artifacts
/obj/
/bin/
/obj-dew/
/bin-dew/

# Generated packaging files (produced from *.in templates by make)
/pkg/rpm/eq3_6.spec
/pkg/brew/eq3_6.rb

# Extracted Fortran source (regenerated by make extract)
/src/

# Downloaded documentation (fetched by make docs)
/docs/*.pdf

# Packaging build trees and output
/pkg/rpm/build/
/pkg/deb/staging/
/pkg/dist/

# Debian build artifacts (land one level above pkg/deb/ with dpkg-buildpackage)
*.deb
*.changes
*.buildinfo
*.dsc

# Test cache and run artifacts
/tests/.data1_cache

# macOS
.DS_Store

# Vim swap files
*.swp
*.swo
